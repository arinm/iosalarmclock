    "an all-day event" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ein ganztägiger Termin"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "un evento de todo el día"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "un evento de todo el día"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "un événement sur toute la journée"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終日の予定"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "um evento de dia inteiro"
          }
        }
      }
    },
    "An all-day event in a calendar you tick skips your alarms that day. Tick only calendars that mean a day off - a holidays calendar, or one you keep for time off. Birthdays never count." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ganztägiger Termin in einem Kalender, den du auswählst, überspringt deine Wecker an diesem Tag. Wähle nur Kalender, die einen freien Tag bedeuten – etwa einen Feiertagskalender oder einen, den du für Urlaub führst. Geburtstage zählen nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un evento de todo el día en un calendario que marques omite tus alarmas ese día. Marca solo los calendarios que signifiquen un día libre: uno de festivos, o uno que uses para tus días de descanso. Los cumpleaños nunca cuentan."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un evento de todo el día en un calendario que marques omite tus alarmas ese día. Marca solo los calendarios que signifiquen un día libre: uno de festivos, o uno que uses para tus días de descanso. Los cumpleaños nunca cuentan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un événement sur toute la journée dans un calendrier coché ignore vos alarmes ce jour-là. Ne cochez que les calendriers qui signifient un jour de congé : un calendrier de jours fériés, ou un calendrier réservé à vos congés. Les anniversaires ne comptent jamais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックを付けたカレンダーに終日の予定がある日は、アラームをスキップします。チェックするのは、休みを表すカレンダー（祝日のカレンダーや休暇用のカレンダー）だけにしてください。誕生日は対象外です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um evento de dia inteiro em um calendário marcado faz seus alarmes serem pulados naquele dia. Marque apenas calendários que indicam folga – um calendário de feriados ou um que você usa para dias de folga. Aniversários nunca contam."
          }
        }
      }
    },
    "Any lead time, not just 15 min" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
