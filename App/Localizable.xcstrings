    "The alarm won't ring during this range, then resumes automatically. Great for holidays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wecker klingelt in diesem Zeitraum nicht und läuft danach automatisch weiter. Ideal für den Urlaub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La alarma no sonará durante este intervalo y luego se reanuda automáticamente. Ideal para vacaciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La alarma no sonará durante este intervalo y luego se reanuda automáticamente. Ideal para vacaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’alarme ne sonnera pas pendant cette période, puis reprendra automatiquement. Idéal pour les vacances."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この期間はアラームが鳴らず、終わると自動で再開します。休暇にぴったりです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O alarme não toca durante este período e depois retoma automaticamente. Ótimo para férias."
          }
        }
      }
    },
    "The core alarm - countdown, heads-up and Skip today - is free forever. No ads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Grundfunktionen – Countdown, Vorwarnung und „Heute überspringen“ – bleiben für immer kostenlos. Keine Werbung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La alarma básica (cuenta regresiva, aviso previo y Omitir hoy) es gratuita para siempre. Sin anuncios."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La alarma básica (cuenta regresiva, aviso previo y Omitir hoy) es gratuita para siempre. Sin anuncios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’alarme de base – compte à rebours, pré-alerte et « Ignorer aujourd’hui » – est gratuite pour toujours. Sans publicité."
          }
