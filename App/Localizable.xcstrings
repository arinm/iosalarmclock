    },
    " Notifications are off for Punctual, so you won't get those notices." : {
      "comment" : "Appended to the Smart skip footer; keep the leading space if your language uses one",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punctualの通知がオフのため、このお知らせは届きません。"
          }
        }
      }
    },
    "%@" : {
      "comment" : "An alarm's own label, shown verbatim",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@ - snoozed for %lld min. It'll ring again." : {
