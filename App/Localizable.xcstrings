    "" : {

    },
    " Notifications are off for Punctual, so open the app to tap I'm up." : {
      "comment" : "Appended to the Are you up? footer; keep the leading space if your language uses one",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Mitteilungen für Punctual sind ausgeschaltet. Öffne daher die App und tippe auf „Ich bin wach“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Las notificaciones de Punctual están desactivadas, así que abre la app para tocar “Ya me levanté”."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Las notificaciones de Punctual están desactivadas, así que abre la app para tocar “Ya me levanté”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Les notifications sont désactivées pour Punctual : ouvrez l’app pour toucher « Je suis debout »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punctualの通知がオフのため、アプリを開いて「起きました」をタップしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " As notificações do Punctual estão desativadas. Abra o app para tocar em “Acordei”."
          }
        }
      }
    },
    " Notifications are off for Punctual, so you won't get those notices." : {
      "comment" : "Appended to the Smart skip footer; keep the leading space if your language uses one",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Mitteilungen für Punctual sind ausgeschaltet, deshalb erhältst du diese Hinweise nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Las notificaciones de Punctual están desactivadas, así que no recibirás esos avisos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Las notificaciones de Punctual están desactivadas, así que no recibirás esos avisos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Les notifications sont désactivées pour Punctual : vous ne recevrez donc pas ces notifications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punctualの通知がオフのため、このお知らせは届きません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " As notificações do Punctual estão desativadas, então você não receberá esses avisos."
          }
        }
      }
    },
