    "Import your own audio - the first ~30 seconds are used (trimmed & converted automatically). Apple Music tracks are protected and can't be imported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere eigene Audiodateien – verwendet werden die ersten ca. 30 Sekunden (automatisch gekürzt und konvertiert). Apple-Music-Titel sind geschützt und können nicht importiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa tu propio audio: se usan los primeros ~30 segundos (se recorta y convierte automáticamente). Las canciones de Apple Music están protegidas y no se pueden importar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa tu propio audio: se usan los primeros ~30 segundos (se recorta y convierte automáticamente). Las canciones de Apple Music están protegidas y no se pueden importar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez votre propre audio : les 30 premières secondes environ sont utilisées (coupées et converties automatiquement). Les morceaux d’Apple Music sont protégés et ne peuvent pas être importés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きな音声を読み込めます。最初の約30秒が使われます（自動でカット・変換されます）。Apple Musicの曲は保護されているため読み込めません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe seu próprio áudio – são usados os primeiros ~30 segundos (cortados e convertidos automaticamente). Faixas do Apple Music são protegidas e não podem ser importadas."
          }
        }
      }
