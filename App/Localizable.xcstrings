    "%@ · skipped for %@, from your calendar. Need it? Tap Ring anyway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · übersprungen laut Kalender: %2$@. Brauchst du ihn? Tippe auf „Trotzdem klingeln“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · skipped for %2$@, from your calendar. Need it? Tap Ring anyway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · se omite por %2$@, según tu calendario. ¿La necesitas? Toca Sonar de todos modos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · se omite por %2$@, según tu calendario. ¿La necesitas? Toca Sonar de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · ignorée pour %2$@, d’après votre calendrier. Besoin d’elle ? Touchez « Sonner quand même »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@・カレンダーの「%2$@」によりスキップされます。必要なら「それでも鳴らす」をタップしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · pulado por %2$@, do seu calendário. Precisa dele? Toque em “Tocar mesmo assim”."
          }
        }
      }
    },
