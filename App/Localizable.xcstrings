    "Rings a real alarm with your default sound, so you can check the volume and whether it plays on the speaker or your headphones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt einen echten Wecker mit deinem Standardton klingeln, damit du die Lautstärke prüfen kannst und siehst, ob er über den Lautsprecher oder deine Kopfhörer ausgegeben wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace sonar una alarma real con tu sonido predeterminado, para que revises el volumen y si suena por el altavoz o por los auriculares."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace sonar una alarma real con tu sonido predeterminado, para que revises el volumen y si suena por el altavoz o por los auriculares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait sonner une vraie alarme avec votre son par défaut, pour vérifier le volume et si elle passe par le haut-parleur ou par vos écouteurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトのサウンドで本物のアラームを鳴らします。音量や、スピーカーとヘッドフォンのどちらで鳴るかを確認できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca um alarme de verdade com o som padrão, para você conferir o volume e se ele sai no alto-falante ou nos fones de ouvido."
          }
        }
      }
    },
    "Rings again 7 min after Stop, unless you tap I'm up" : {
