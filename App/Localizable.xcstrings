    "Free alarms get a 15-minute heads-up with a Skip today button. Custom & multiple heads-ups are part of Pro." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose Wecker erhalten 15 Minuten vorher eine Vorwarnung mit der Schaltfläche „Heute überspringen“. Eigene und mehrere Vorwarnungen gehören zu Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alarmas del plan gratuito tienen un aviso previo de 15 minutos con un botón Omitir hoy. Los avisos previos personalizados y múltiples forman parte de Pro."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alarmas del plan gratuito tienen un aviso previo de 15 minutos con un botón Omitir hoy. Los avisos previos personalizados y múltiples forman parte de Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alarmes de la version gratuite reçoivent une pré-alerte 15 minutes avant, avec un bouton « Ignorer aujourd’hui ». Les pré-alertes personnalisées et multiples font partie de Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料のアラームには、「今日をスキップ」ボタン付きの事前通知が15分前に届きます。タイミングの変更や複数の事前通知はProの機能です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os alarmes gratuitos recebem um alerta prévio de 15 minutos com um botão Pular hoje. Alertas prévios personalizados e múltiplos fazem parte do Pro."
          }
        }
      }
