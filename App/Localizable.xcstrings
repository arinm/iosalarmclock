    "Not available yet. Pro owners get these free as they ship; subscriber perks are for monthly & yearly plans." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht verfügbar. Wer Pro besitzt, erhält diese Funktionen kostenlos, sobald sie erscheinen; Abo-Vorteile gelten für Monats- und Jahresabos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
