    "Holiday & calendar auto-skip" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feiertage & Kalender automatisch überspringen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omisión por festivos y calendario"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omisión por festivos y calendario"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorer auto : jours fériés et calendrier"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "祝日・カレンダーの自動スキップ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulo automático por feriados e calendário"
          }
        }
      }
    },
    "Holiday calendars can include days that aren't days off, like Valentine's Day or Tax Day. The evening before a day off you get one quiet notice, with Ring anyway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feiertagskalender können Tage enthalten, die keine freien Tage sind, etwa den Valentinstag oder Halloween. Am Abend vor einem freien Tag erhältst du einen leisen Hinweis mit „Trotzdem klingeln“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los calendarios de festivos pueden incluir días que no son libres, como San Valentín o la fecha límite de impuestos. La tarde anterior a un día libre recibes un aviso discreto, con Sonar de todos modos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los calendarios de festivos pueden incluir días que no son libres, como San Valentín o la fecha límite de impuestos. La tarde anterior a un día libre recibes un aviso discreto, con Sonar de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les calendriers de jours fériés peuvent inclure des jours qui ne sont pas des congés, comme la Saint-Valentin ou la fête des Mères. La veille au soir d’un jour de congé, vous recevez une notification discrète, avec « Sonner quand même »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "祝日のカレンダーには、バレンタインデーなど休みではない日が含まれることがあります。休みの前日の夜に、「それでも鳴らす」付きの静かなお知らせが1回届きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendários de feriados podem incluir dias que não são folga, como o Dia dos Namorados ou o Dia das Mães. Na noite anterior a uma folga, você recebe um aviso discreto, com “Tocar mesmo assim”."
          }
        }
      }
    },
