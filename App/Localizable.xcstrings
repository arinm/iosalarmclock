    "For anything you can't afford to miss, set a second alarm - ideally in another app or on another device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für alles, was du nicht verpassen darfst: Stelle einen zweiten Wecker – am besten in einer anderen App oder auf einem anderen Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cualquier compromiso que no puedas perderte, programa una segunda alarma, idealmente en otra app o en otro dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cualquier compromiso que no puedas perderte, programa una segunda alarma, idealmente en otra app o en otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour tout ce que vous ne pouvez pas vous permettre de manquer, réglez une seconde alarme – idéalement dans une autre app ou sur un autre appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絶対に遅れられない予定には、別のアラームも設定してください。できれば別のアプリや別の端末で。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para qualquer compromisso que você não pode perder, programe um segundo alarme – de preferência em outro app ou em outro dispositivo."
          }
        }
      }
    },
